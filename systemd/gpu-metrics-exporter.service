[Unit]
Description=GPU metrics exporter service
After=network-online.target

[Service]
Type=simple
User=root
Group=root
Environment=GPU_METRICS_EXPORTER_SERVER_PORT=9999
ExecStart=/usr/local/bin/gpu-metrics-exporter -tickPeriod 60
Restart=always
RestartSec=1min
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gpu-metrics-exporter

[Install]
WantedBy=multi-user.target
