[Unit]
Description=Upgrade gpu-metrics-exporter to its latest release
Documentation=https://github.com/mws-cloud-platform/gpu-metrics-exporter#auto-update
Wants=network-online.target
After=network-online.target

# Started by gpu-metrics-exporter-update.timer. A unit of its own, never a step
# of gpu-metrics-exporter.service: the package's prerm stops that service, and
# with it everything in its cgroup -- dpkg included, halfway through.
[Service]
Type=oneshot
ExecStart=/usr/local/bin/gpu-metrics-exporter update -auto
# 75 (EX_TEMPFAIL, selfupdate.ExitTempFail): the update failed before it
# changed anything -- no network, GitHub unreachable or rate limited, a download
# that did not check out. The next run tries again; until then, a VM that cannot
# reach GitHub need not show a failed unit three times a day. A failed install
# exits 1 and fails the unit.
SuccessExitStatus=75
SyslogIdentifier=gpu-metrics-exporter-update
